{
  "name": "jaxsquares",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first web app for playing sports games with friends — starting with Super Bowl Squares.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run seo:pages",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply jaxsquares --local",
    "db:migrate:remote": "wrangler d1 migrations apply jaxsquares --remote",
    "cf-typegen": "wrangler types",
    "brand": "node --experimental-strip-types scripts/brand/generate.ts",
    "seo:pages": "node --experimental-strip-types scripts/seo/build.ts",
    "seo:images": "node --experimental-strip-types scripts/seo/images.ts",
    "seo:printables": "node --experimental-transform-types scripts/seo/printables.ts",
    "ios": "VITE_API_BASE=https://jaxsquares.com npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "^8.5.12",
    "@capgo/native-purchases": "^8.9.6",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@stripe/stripe-js": "^10.1.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.19.0",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@cloudflare/vite-plugin": "^1.0.12",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.5",
    "wrangler": "^4.98.0"
  }
}
