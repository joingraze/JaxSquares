{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts",
    "capacitor.config.ts",
    "scripts/**/*.ts"
  ],
  // The ops scripts import worker modules: tsconfig.ops.json checks them with the Workers types too.
  "exclude": [
    "scripts/ops"
  ]
}
