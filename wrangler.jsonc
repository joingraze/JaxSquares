{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaxsquares",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    // Built SPA assets are served for any non-API route. Unknown paths fall
    // back to index.html so client-side routing works on deep links. The
    // binding lets the Worker delegate non-API routes to the asset server.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Let the Worker see /g/* first so it can add per-game link previews,
    // /.well-known/* so it can serve universal-link files, and the big game
    // page's old address so it can redirect it.
    "run_worker_first": ["/api/*", "/g/*", "/.well-known/*", "/super-bowl-squares", "/super-bowl-squares/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jaxsquares",
      "database_id": "79e14421-73d5-4b10-b571-0c5509e18027",
      "migrations_dir": "migrations"
    }
  ],
  // One GameRoom per game: live sockets, presence, and live-score polling.
  // One ScoreHub per league: every ESPN request goes through it (shared cache).
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "SCORE_HUB", "class_name": "ScoreHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ScoreHub"] }
  ],
  // Wake rooms of linked games that are about to start or in progress, and
  // read season boards' team schedules for new games (about twice a day each).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ORIGIN": "https://jaxsquares.com",
    // "live" = the real Stripe checkout, once the Stripe keys are set as
    // secrets (until then the no-charge test checkout runs). The Stripe setup
    // workflow (.github/workflows/stripe-setup.yml) stores the keys and makes
    // the Prices, webhook and portal settings; their ids go below. The App
    // Store keys only matter once the iOS app ships.
    "PAYMENTS_MODE": "live",
    // Two products (docs/payments.md "Pricing", shared/pricing.ts). Per game:
    // one board's host fee, plus the Venue add-on on a venue board (web only),
    // charged by amount at the draw (no Stripe Price needed).
    "BOARD_PRICE_CENTS": "499",
    "VENUE_PRICE_CENTS": "1000",
    "IAP_PRODUCT_ID": "com.jaxsquares.app.board",
    // The Annual Pass, yearly (docs/payments.md "Annual Pass"). In live mode the
    // web sells it only once STRIPE_HOST_PASS_PRICE_ID names the Stripe Price.
    "HOST_PASS_PRICE_CENTS": "1999",
    "STRIPE_HOST_PASS_PRICE_ID": "",
    "IAP_HOST_PASS_PRODUCT_ID": "com.jaxsquares.app.hostpass.yearly",
    // The Annual Pass with the Venue add-on, yearly, web only (plan "club"). In
    // live mode the web sells it only once STRIPE_CLUB_PASS_PRICE_ID names its
    // $99.99/year Price; until then it's off (the old $49 Club Pass Price is
    // retired: its subscriptions keep renewing as venue passes).
    "CLUB_PASS_PRICE_CENTS": "9999",
    "STRIPE_CLUB_PASS_PRICE_ID": "",
    // The Customer Portal settings Manage opens (bpc_..., made by the Stripe
    // setup workflow). Empty: Stripe's default portal settings.
    "STRIPE_PORTAL_CONFIGURATION_ID": "",
    // Optional sign-in (docs/auth.md). Public OAuth client ids, not secrets;
    // empty = that provider is hidden in the app. Native Sign in with Apple
    // uses APPLE_BUNDLE_ID (default com.jaxsquares.app, the Capacitor appId).
    "GOOGLE_WEB_CLIENT_ID": "643193678078-07e1nlo54pklf2f785t1gnc2m80mdc96.apps.googleusercontent.com",
    "GOOGLE_IOS_CLIENT_ID": "",
    "APPLE_SERVICES_ID": "com.jaxsquares.web",
    // Email notices (docs/email.md): the sender, e.g. "JaxSquares
    // <notices@jaxsquares.com>", once the domain is verified with Resend.
    // Empty = off (with the RESEND_API_KEY and EMAIL_TOKEN_SECRET secrets).
    "EMAIL_FROM": ""
  }
}
